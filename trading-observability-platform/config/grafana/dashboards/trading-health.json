{
  "uid": "saat-trading-health",
  "title": "Trading Health & Risk Overview (Proposed Sandbox SLIs)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["trading", "observability", "health"],
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Market Data Age (seconds) — Proposed Threshold 2.0s",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "max by (venue) (trading_market_data_age_seconds)", "legendFormat": "{{venue}}"}]
    },
    {
      "id": 2,
      "title": "Risk Engine State (0=Healthy, 1=Degraded, 2=Breach/Kill-Switch)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "max(trading_risk_state_code)", "legendFormat": "risk_state"}]
    },
    {
      "id": 3,
      "title": "Paper Order Rate by Status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum by (status) (rate(trading_orders_total{service=\"oms\"}[1m]))", "legendFormat": "{{status}}"}]
    },
    {
      "id": 4,
      "title": "Reconciliation Mismatches (Broker vs Portfolio)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "sum(trading_reconciliation_mismatches_total)", "legendFormat": "mismatches"}]
    }
  ]
}
